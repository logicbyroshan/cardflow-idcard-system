# Development Setup
# Uncomment the line below and replace with your computer's local IP address to test locally.
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.100:8000

# Production Setup
# When deploying or building the app, comment out the local IP and use the live URL:
EXPO_PUBLIC_API_URL=https://panel.adarshbhopal.in

# Web-Share API Integration / Landing Website Integration
# Base URL of the landing website domain.
# Local development: http://localhost:8001
# Production: https://www.adarshbhopal.in
EXPO_PUBLIC_WEB_SHARE_BASE_URL=https://www.adarshbhopal.in
EXPO_PUBLIC_WEB_SHARE_API_KEY=adarsh_secure_fallback_key_2026_web_app
