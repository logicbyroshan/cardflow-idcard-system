# =============================================================================
# Adarsh Admin — Environment Variables
# Copy this file as .env and fill in production values.
# NEVER commit .env to version control.
# =============================================================================

# --- Core ---
SECRET_KEY=your-secret-key
DEBUG=False

# --- Allowed Hosts (comma-separated) ---
ALLOWED_HOSTS=adarshbhopal.in,www.adarshbhopal.in

# --- Database ---
DATABASE_URL=postgres://user:password@localhost:5432/adarsh_db

# --- CSRF ---
CSRF_TRUSTED_ORIGINS=https://adarshbhopal.in,https://www.adarshbhopal.in

# --- Email (SMTP) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# --- Site URL (for email links) ---
SITE_URL=https://adarshbhopal.in

# --- SSL (production) ---
SECURE_SSL_REDIRECT=True

# --- App Version (auto-set by CD pipeline) ---
APP_VERSION=1.0.0

TIME_ZONE=Asia/Kolkata
