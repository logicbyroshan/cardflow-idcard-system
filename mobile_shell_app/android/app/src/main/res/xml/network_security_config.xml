<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Block all cleartext (HTTP) traffic by default -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Explicitly allow only the app's own domain over HTTPS -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">panel.adarshbhopal.in</domain>
        <domain includeSubdomains="true">adarshbhopal.in</domain>
    </domain-config>
</network-security-config>
