# Gunicorn Systemd Service for Adarsh Admin
# ==========================================
#
# Installation:
#   sudo cp gunicorn.service /etc/systemd/system/adarsh.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable adarsh
#   sudo systemctl start adarsh
#
# Commands:
#   sudo systemctl status adarsh
#   sudo systemctl restart adarsh
#   sudo journalctl -u adarsh -f

[Unit]
Description=Adarsh Admin Gunicorn Daemon
Requires=network.target
After=network.target

[Service]
Type=notify
User=www-data
Group=www-data
RuntimeDirectory=gunicorn
WorkingDirectory=/path/to/project
ExecStart=/path/to/venv/bin/gunicorn \
    --config /path/to/project/deployment/gunicorn.conf.py \
    config.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStartSec=30
TimeoutStopSec=30
PrivateTmp=true
Restart=on-failure
RestartSec=5

# Resource limits for 2GB RAM server
# Prevent memory exhaustion from killing system
MemoryMax=1400M
MemoryHigh=1200M

# Environment variables
Environment="DJANGO_SETTINGS_MODULE=config.settings"
Environment="PYTHONUNBUFFERED=1"

# Create required directories
ExecStartPre=/bin/mkdir -p /var/log/gunicorn
ExecStartPre=/bin/mkdir -p /run/gunicorn

[Install]
WantedBy=multi-user.target
